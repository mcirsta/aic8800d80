# SPDX-License-Identifier: GPL-2.0-only
# Portable quirk for the verified compound AIC/FLASH installer revision.
# The helper validates descriptors, parent hub and an actual direct AIC sibling;
# there are no bus/port names, mode-switch commands or generic 1111 blacklists.
# Trigger from both USB sides and disk publication to handle either event order.
ACTION!="add", GOTO="aic8800_installer_end"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTR{bInterfaceClass}=="08", ATTRS{idVendor}=="1111", ATTRS{idProduct}=="1111", RUN+="/usr/libexec/aic8800-installer-policy --apply /sys%p"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="a69c", ATTR{idProduct}=="8d8[01]", RUN+="/usr/libexec/aic8800-installer-policy --apply /sys%p"
SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", ATTRS{idVendor}=="1111", ATTRS{idProduct}=="1111", RUN+="/usr/libexec/aic8800-installer-policy --apply /sys%p"
LABEL="aic8800_installer_end"
